<?xml version="1.0" encoding="utf-8"?>
<!-- Pysanka: nothing leaves the phone, neither to a cloud backup nor in a phone-to-phone transfer.
     (allowBackup="false" alone does not stop device-to-device transfer on Android 12+.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
